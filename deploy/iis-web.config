<?xml version="1.0" encoding="UTF-8"?>
<!-- Для Windows Server с IIS: обратный прокси на node server.js (нужны модули URL Rewrite и Application Request Routing).
     Положите этот файл как web.config в корень сайта IIS. Сам node server.js запускайте службой (например, через NSSM). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="load-planner" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security><requestFiltering><requestLimits maxAllowedContentLength="12582912" /></requestFiltering></security>
  </system.webServer>
</configuration>
